{
  "name": "@trysac/mcp-readonly-fs",
  "version": "0.0.0",
  "description": "Read-only MCP filesystem server over allowlisted roots with realpath containment, deny globs on real paths, size and binary caps, and readOnlyHint tools",
  "license": "MIT",
  "author": "Miguel Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trysac/u022-mcp-readonly-fs.git"
  },
  "homepage": "https://github.com/Trysac/u022-mcp-readonly-fs#readme",
  "bugs": {
    "url": "https://github.com/Trysac/u022-mcp-readonly-fs/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^4.1.0"
  }
}
